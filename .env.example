DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/safer247_db
APP_ENV=development
# Set privately to capstone during prototype; rotate before stakeholder deployment.
# Generate the salted Argon2 hash in cd backend with: python -m app.auth.registration_code
OPERATOR_REGISTRATION_CODE_HASH=
# Offline packs must be independently licensed and must NOT contain cached Google tiles.
# Optional local XYZ tile directory with z/x/y.png layout.
OFFLINE_TILE_DIR=
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: set these only when creating a local demo operator.
DEMO_OPERATOR_CALL_SIGN=Demo
DEMO_OPERATOR_PASSWORD=

# Radio configuration
RADIO_ENABLED=false
RADIO_STATION=N0CALL
RADIO_SAMPLE_RATE=48000
RADIO_STORAGE_DIR=D:\SAFER247\radio
RADIO_SPOOL_DIR=
RADIO_OUTPUT_DIR=
RADIO_GEN_PACKETS=app/radio_lab/aprs/Tools/gen_packets.exe
RADIO_ATEST=app/radio_lab/aprs/Tools/atest.exe
RADIO_ENHANCE=true
RADIO_COMMAND_TIMEOUT=60
RADIO_INPUT_COMMAND=
RADIO_OUTPUT_COMMAND=
RADIO_INPUT_DEVICE=
RADIO_OUTPUT_DEVICE=
RADIO_INPUT_ENABLED=true
RADIO_OUTPUT_ENABLED=true
