# Load this file into the API environment after configuring the
# existing project's DATABASE_URL and PASSWORD_FINGERPRINT_SECRET.
# The API starts and supervises the worker when enabled.
RADIO_ENABLED=true
# Replace N0CALL with your configured AX.25 station before device integration.
RADIO_STATION=N0CALL
RADIO_SAMPLE_RATE=48000
# Paths below are relative to backend/. Absolute paths are recommended for services.
RADIO_STORAGE_DIR=app/radio_lab/var
RADIO_SPOOL_DIR=app/radio_lab/var/incoming
RADIO_OUTPUT_DIR=app/radio_lab/var/outgoing
RADIO_GEN_PACKETS=gen_packets
RADIO_ATEST=atest
RADIO_ENHANCE=true
# Maximum time to wait for the configured audio output command.
RADIO_COMMAND_TIMEOUT=60
# Optional device name or unique fragment. Empty selects the host default.
# A missing configured device falls back to the host default; an enumerated but
# unusable configured device reports an error without switching.
RADIO_INPUT_DEVICE=
RADIO_OUTPUT_DEVICE=
# Set false to disable microphone capture while keeping WAV-spool input.
RADIO_INPUT_ENABLED=true
# Set false for encode-to-WAV-only operation; no output audio will be played.
RADIO_OUTPUT_ENABLED=true
# Commands override native device selection and are retained for existing setups.
RADIO_INPUT_COMMAND=
RADIO_OUTPUT_COMMAND=
# Optional command capture emits continuous raw mono S16_LE PCM at 48000 Hz.
# These POSIX examples require replacing the placeholder with a real device.
# RADIO_INPUT_COMMAND='["arecord","-D","YOUR_INPUT_DEVICE","-t","raw","-f","S16_LE","-r","48000","-c","1"]'
# Optional output command gets one complete WAV. It must manage PTT if required.
# RADIO_OUTPUT_COMMAND='["aplay","-D","YOUR_OUTPUT_DEVICE","{wav}"]'
